native/build/
native/build-nmake/
# ~94 MB of raw oracle dumps: kept on disk for inspection, reproducible with
# `bash check-oracle.sh <oracle.exe> evidence/final`, out of git because a
# 945k-line diff is not reviewable. The gate result is in oracle-gate-summary.txt.
evidence/**/oracle-survey-*.txt
evidence/**/oracle-enters-*.txt
# One raw probe report per demo. 1643 reports for the full corpus run: kept on
# disk so a failure can be re-read instead of re-run, but they are derived data.
# The gate reads corpus-summary.json + corpus-failures.txt, which stay tracked.
#
# The rule excludes the *contents* rather than the directory, and the 24
# calibration reports are re-included, because those 24 are not derived data:
# verify-all.sh step 9 compares its mutated copies against them as the frozen
# baseline, the way evidence/probe-baseline/ is a frozen baseline. Leaving them
# ignored meant a fresh clone had the pinned 24-name list (demos.txt is tracked)
# and none of the reports it names, so step 9 read `pinned_reports=0` and failed
# 48 assertions -- an undeclared input dependency on one machine's disk. It is
# not possible to re-include a file whose parent directory is excluded, which is
# why the pattern ends in `/*` instead of `/`.
evidence/corpus*/reports/*
!evidence/corpus-calib/reports/*.txt
evidence/corpus*/corpus.csv
# Truncated and rewritten by every build-cmake.sh run, so it churns on every
# commit. The build reading that matters is captured per run in
# evidence/verify/1-build.txt.
evidence/cmake-build.log
# Diagnostic git worktrees (p0-tree / p1-tree) used for before-and-after
# experiments. Each one carries a .git pointer file, so tracking the directory
# would commit worktree plumbing rather than source.
.scratch/

# 分层验收（verify-fast / verify-entity / verify-render / verify-audio）的输出。
# 这些门禁每轮要跑很多次，产物是工作读数而不是该提交的证据 —— 每个提交保留的
# 证据是完整链的 evidence/verify/（见 README「分级验收」一节）。留在盘上供复核，
# 不进 git，否则每跑一次就脏一次工作树，而 mutate.sh 那类脚本需要干净的树。
evidence/fast/

# weapon-animation-check.sh 的 trace 与 metrics CSV 是机器产物：三个 tick 约 15 万行，
# CSV 里的 elapsed_seconds / fps / working_set_bytes 每次运行都不同。默认写进
# evidence/fast/weapon-animation/（上面那条已经覆盖），这里再按扩展名兜一层，
# 免得有人把 TRACE_DIR 指到提交目录里就顺手把 9 MB trace 提交上去。
# 提交的是冻结见证帧（tick-*.bmp、model-*.bmp）、readings.txt 与 mutation-failure.txt。
evidence/weapon-animation/*.trace
evidence/weapon-animation/*.log
evidence/weapon-animation/**/*.trace
evidence/weapon-animation/**/*.log

# verify-all.sh 第 22 步把 weapon-animation-check.sh 的输出指到 evidence/verify/ 下，
# 但那里同样是机器产物：三个 trace 目录共 61 MB（每行带 elapsed_seconds/fps/working_set），
# 帧是 10 张 2.5 MB 的 BMP —— 且它们与已提交的冻结见证帧 evidence/weapon-animation/*.bmp
# **逐字节相同**（2026-10-10 用 cmp 逐张验过，10/10 IDENTICAL），再提交一份只是重复。
# 第 22 步留在主线的是三个 verdict 日志与两份 mutation-failure 文本（原始失败信息）。
evidence/verify/22-weapon-animation-traces/
evidence/verify/22-weapon-animation-mutation-traces/
evidence/verify/22-weapon-animation-mutation-model-traces/
evidence/verify/22-weapon-animation/

# 合并用补丁（由 git 历史派生，随时可再生成；见 MERGE-MANIFEST-2026-10-08.md §6）
merge-patches/

# The mutated frame is regenerated from paused.bmp by frame-capture-check.sh --mutation;
# it is a one-byte edit of a file already kept, so it carries no independent evidence.
evidence/frame-capture/mutated.bmp
