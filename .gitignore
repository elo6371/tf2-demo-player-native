native/build/
native/build-nmake/
# ~94 MB of raw oracle dumps: kept on disk for inspection, reproducible with
# `bash check-oracle.sh <oracle.exe> evidence/final`, out of git because a
# 945k-line diff is not reviewable. The gate result is in oracle-gate-summary.txt.
evidence/**/oracle-survey-*.txt
evidence/**/oracle-enters-*.txt
# One raw probe report per demo. 1643 reports for the full corpus run: kept on
# disk so a failure can be re-read instead of re-run, but they are derived data.
# The gate reads corpus-summary.json + corpus-failures.txt, which stay tracked.
evidence/corpus*/reports/
evidence/corpus*/corpus.csv
# Truncated and rewritten by every build-cmake.sh run, so it churns on every
# commit. The build reading that matters is captured per run in
# evidence/verify/1-build.txt.
evidence/cmake-build.log
# Diagnostic git worktrees (p0-tree / p1-tree) used for before-and-after
# experiments. Each one carries a .git pointer file, so tracking the directory
# would commit worktree plumbing rather than source.
.scratch/
