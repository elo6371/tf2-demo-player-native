+    out.write(8191, 13);
+    out.write(0, 1);
+    writeSentinelTick(out);
+    const RunOutcome outcome = run(summary, out);
+    check(sentinelReached(summary, outcome), "svc_BSPDecal: bit-coord + ent/model form");
+    check(summary.bspDecalCount == 1, "svc_BSPDecal: counted once");
+  }
