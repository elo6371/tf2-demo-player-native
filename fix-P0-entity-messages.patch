+    BitWriter out;
+    out.write(21, 6);
+    out.write(1, 1); out.write(0, 1); out.write(0, 1);
+    out.write(1, 1); out.write(0, 1); out.write(0, 1); out.write(1, 14); out.write(0, 5);
