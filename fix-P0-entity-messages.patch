+    DemoNetworkSummary summary = makeSummary();
+    BitWriter out;
+    out.write(21, 6);
+    out.write(0, 1); out.write(1, 1); out.write(0, 1);
+    out.write(0, 1); out.write(1, 1); out.write(1, 1); out.write(17, 5);
+    out.write(0, 9);
+    out.write(0, 1);
+    out.write(0, 1);
+    writeSentinelTick(out);
